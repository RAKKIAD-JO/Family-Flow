generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  user_id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String?
  password String
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions Transactions[]
  accounts     Accounts[]
}

model Accounts {
  account_id       Int    @id @default(autoincrement())
  name     String 
  balance  Float  @default(0)
  currency String @default("THB")

  userId       Int
  user         Users          @relation(fields: [userId], references: [user_id])
  transactions Transactions[]

  createdAt DateTime @default(now())
}

model Categories {
  category_id   Int          @id @default(autoincrement())
  name String
  type CategoryType

  parentId Int? 
  parent   Categories?  @relation("CategoryHierarchy", fields: [parentId], references: [category_id])
  children Categories[] @relation("CategoryHierarchy")

  transactions Transactions[]
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transactions {
  transaction_id          Int     @id @default(autoincrement())
  amount      Float
  description String?

  date       DateTime @default(now())
  isPersonal Boolean  @default(true)


  userId Int
  user   Users @relation(fields: [userId], references: [user_id])

  categoryId Int
  category   Categories @relation(fields: [categoryId], references: [category_id])

  accountId Int
  account   Accounts @relation(fields: [accountId], references: [account_id])

  // Analytics-friendly
  createdAt DateTime @default(now())

  tags TransactionTag[]
}

model Tag {
  tag_id   Int    @id @default(autoincrement())
  name String @unique

  transactions TransactionTag[]
}

model TransactionTag {
  transactionId Int
  tagId         Int

  transaction Transactions @relation(fields: [transactionId], references: [transaction_id])
  tag         Tag         @relation(fields: [tagId], references: [tag_id])

  @@id([transactionId, tagId])
}
